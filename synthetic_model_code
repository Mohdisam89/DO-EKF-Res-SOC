# 4. Residual windowed dataset and model
# ============================================================
def build_windows(Fn, length, window):
    pad = np.tile(Fn[0:1], (window - 1, 1))
    Fp = np.vstack([pad, Fn])
    return np.stack([Fp[i:i+window] for i in range(length)], axis=0).astype(np.float32)


def smooth_residual_target(r, window=RESIDUAL_SMOOTH_WINDOW):
    """Low-pass residual target to reduce high-frequency noise before BiLSTM learning."""
    r = np.asarray(r, dtype=np.float64)
    if window is None or window <= 1 or len(r) < 5:
        return r.astype(np.float32)
    w = int(window)
    if w % 2 == 0:
        w += 1
    w = min(w, len(r) if len(r) % 2 == 1 else len(r)-1)
    if w < 5:
        return r.astype(np.float32)
    if savgol_filter is not None and w >= 5:
        try:
            return savgol_filter(r, window_length=w, polyorder=2, mode="interp").astype(np.float32)
        except Exception:
            pass
    kernel = np.ones(w, dtype=np.float64) / w
    return np.convolve(r, kernel, mode="same").astype(np.float32)


def stack_residual_windowed_features(cases, feat_names, window, mu=None, sig=None,
                                      return_weights=False, hard_mining=False,
                                      min_abs=HARD_RESIDUAL_MIN_ABS):
    """
    Build BiLSTM residual-learning windows.

    Updates for stable residual learning:
      1) The residual target is smoothed to reduce high-frequency noise.
      2) Training can use hard-residual mining, i.e., samples are retained only
         when |SOC_true - SOC_DU| exceeds a physically meaningful threshold.
      3) Larger residuals receive larger loss weights.

    hard_mining should be True for residual training/validation and False for
    full-sequence evaluation.
    """
    all_F = np.concatenate([np.vstack([D[f] for f in feat_names]).T for D in cases], axis=0)
    if mu is None:
        mu = all_F.mean(axis=0)
        sig = all_F.std(axis=0)
        sig[sig < 1e-12] = 1.0

    Xw_list, Yres_list, W_list = [], [], []
    kept_total, raw_total = 0, 0

    for D in cases:
        F = np.vstack([D[f] for f in feat_names]).T
        Fn = (F - mu) / sig

        residual_raw = np.clip(D["SOC_true"] - D["SOC_DU"], -RESIDUAL_CLIP, RESIDUAL_CLIP).astype(np.float32)
        residual = smooth_residual_target(residual_raw)
        residual = np.clip(residual, -RESIDUAL_CLIP, RESIDUAL_CLIP).astype(np.float32)

        Xfull = build_windows(Fn, len(residual), window)

        if hard_mining:
            mask = np.abs(residual_raw) >= float(min_abs)
            # Safety fallback: if a scenario has very few hard samples, keep the top 10% by residual magnitude.
            if mask.sum() < max(20, int(0.03 * len(mask))):
                thr = np.percentile(np.abs(residual_raw), 90)
                mask = np.abs(residual_raw) >= thr
        else:
            mask = np.ones(len(residual), dtype=bool)

        # Emphasise large residuals smoothly instead of treating all retained samples equally.
        weights = 1.0 + RESIDUAL_IMPORTANCE_GAIN * np.minimum(np.abs(residual_raw) / max(min_abs, 1e-12), 3.0)
        weights = weights.astype(np.float32)

        Xw_list.append(Xfull[mask])
        Yres_list.append(residual[mask])
        W_list.append(weights[mask])
        kept_total += int(mask.sum())
        raw_total += int(len(mask))

    X = np.concatenate(Xw_list).astype(np.float32)
    Y = np.concatenate(Yres_list).astype(np.float32)
    W = np.concatenate(W_list).astype(np.float32)

    mode = "hard-mined" if hard_mining else "full"
    print(f"Residual dataset mode={mode}: kept {kept_total}/{raw_total} samples ({100*kept_total/max(raw_total,1):.1f}%)")

    if return_weights:
        return X, Y, W, mu, sig
    return X, Y, mu, sig


class AttentionLayer(nn.Module):
    def __init__(self, hidden_size):
        super().__init__()
        self.attn = nn.Linear(hidden_size, 1)
    def forward(self, lstm_out):
        weights = torch.softmax(self.attn(lstm_out), dim=1)
        return (lstm_out * weights).sum(dim=1)


class ResidualBiLSTMNet(nn.Module):
    def __init__(self, n_feat=8, hidden=64, n_layers=2):
        super().__init__()
        self.lstm = nn.LSTM(n_feat, hidden, num_layers=n_layers, batch_first=True,
                            bidirectional=True, dropout=0.15 if n_layers > 1 else 0.0)
        self.attention = AttentionLayer(hidden * 2)
        self.fc = nn.Sequential(nn.Linear(hidden*2, 32), nn.ReLU(), nn.Dropout(0.10),
                                nn.Linear(32, 1), nn.Tanh())
    def forward(self, x):
        o, _ = self.lstm(x)
        ctx = self.attention(o)
        return self.fc(ctx).squeeze(-1) * PRED_CLIP


def train_residual_net(net, Xtr, Ytr, Xvl, Yvl, epochs, lr, device,
                       batch_size=BATCH_SIZE, patience=15, Wtr=None, Wvl=None):
    """Train residual BiLSTM using weighted SmoothL1 loss and live validation curves."""
    net.to(device)
    opt = optim.Adam(net.parameters(), lr=lr, weight_decay=2e-5)
    scheduler = optim.lr_scheduler.ReduceLROnPlateau(opt, patience=5, factor=0.5, min_lr=1e-5)
    crit = nn.SmoothL1Loss(beta=0.005, reduction="none")

    if Wtr is None:
        Wtr = np.ones_like(Ytr, dtype=np.float32)
    if Wvl is None:
        Wvl = np.ones_like(Yvl, dtype=np.float32)

    train_ds = TensorDataset(
        torch.tensor(Xtr, dtype=torch.float32),
        torch.tensor(Ytr, dtype=torch.float32),
        torch.tensor(Wtr, dtype=torch.float32),
    )
    loader = DataLoader(train_ds, batch_size=batch_size, shuffle=True)

    xvl = torch.tensor(Xvl, dtype=torch.float32, device=device)
    yvl = torch.tensor(Yvl, dtype=torch.float32, device=device)
    wvl = torch.tensor(Wvl, dtype=torch.float32, device=device)

    best_val = np.inf
    best_state = None
    best_epoch = 0
    bad = 0
    hist = []

    for ep in range(1, epochs + 1):
        net.train()
        total = 0.0
        for xb, yb, wb in loader:
            xb, yb, wb = xb.to(device), yb.to(device), wb.to(device)
            opt.zero_grad(set_to_none=True)
            pred = net(xb)
            loss_vec = crit(pred, yb)
            loss = (loss_vec * wb).mean()
            loss.backward()
            nn.utils.clip_grad_norm_(net.parameters(), 1.0)
            opt.step()
            total += loss.item()

        train_loss = total / max(1, len(loader))
        net.eval()
        with torch.no_grad():
            pred_v = net(xvl)
            val_rmse = torch.sqrt(torch.mean((pred_v - yvl) ** 2)).item() * 100
            val_wrmse = torch.sqrt(torch.sum(wvl * (pred_v - yvl) ** 2) / torch.sum(wvl)).item() * 100

        scheduler.step(val_rmse)
        current_lr = opt.param_groups[0]["lr"]
        hist.append({
            "epoch": ep,
            "train_loss": train_loss,
            "val_residual_rmse": val_rmse,
            "val_weighted_residual_rmse": val_wrmse,
            "lr": current_lr,
            "best_epoch": best_epoch,
        })

        if val_rmse < best_val - 1e-5:
            best_val = val_rmse
            best_state = {k: v.detach().cpu().clone() for k, v in net.state_dict().items()}
            best_epoch = ep
            bad = 0
        else:
            bad += 1

        if ep % LIVE_PLOT_EVERY == 0:
            plot_residual_training_progress(hist)
            pd.DataFrame(hist).to_csv(os.path.join(OUT_DIR, "residual_training_history_live.csv"), index=False)

        if ep == 1 or ep % 5 == 0 or bad == 0:
            print(
                f"Residual Epoch {ep:03d}/{epochs} | "
                f"Train loss={train_loss:.6e} | Val residual RMSE={val_rmse:.4f}% | "
                f"Best={best_val:.4f}% @ {best_epoch} | LR={current_lr:.1e}"
            )

        if bad >= patience:
            print(f"Residual early stopping at epoch {ep} | best epoch={best_epoch} | best Val RMSE={best_val:.4f}%")
            break

    if best_state is not None:
        net.load_state_dict({k: v.to(device) for k, v in best_state.items()})

    hist_df = pd.DataFrame(hist)
    hist_df.to_csv(os.path.join(OUT_DIR, "residual_training_history.csv"), index=False)
    plot_residual_training_progress(hist)
    return net, hist_df

def predict_residual_sequence(net, D, feat_names, mu, sig, window, device):
    F = np.vstack([D[f] for f in feat_names]).T
    Fn = (F - mu) / sig
    Xw = build_windows(Fn, len(D["SOC_true"]), window)
    net.eval()
    with torch.no_grad():
        res = net(torch.tensor(Xw, dtype=torch.float32, device=device)).cpu().numpy()
    return np.clip(res, -PRED_CLIP, PRED_CLIP)


def confidence_gate(residual, beta=CONF_GATE_BETA, min_alpha=CONF_GATE_MIN_ALPHA):
    """
    Sigmoid confidence-guided residual scaling.

    Corrections below approximately 0.7% SOC are retained with high confidence,
    whereas larger corrections are progressively down-weighted to reduce harmful
    residual overshoot in scenarios where DO-EKF is already accurate.
    """
    residual = np.asarray(residual, dtype=np.float32)
    alpha = 1.0 / (1.0 + np.exp(beta * (np.abs(residual) - 0.007)))
    return np.clip(alpha, min_alpha, 1.0).astype(np.float32)


def apply_residual_correction(du, res_pred_raw, gain=1.0):
    """Apply thresholded confidence-guided residual correction."""
    if USE_CONFIDENCE_GATE:
        alpha = confidence_gate(res_pred_raw)
    else:
        alpha = np.ones_like(res_pred_raw, dtype=np.float32)

    # Ignore tiny predicted corrections, which are usually noise-dominated.
    active = np.abs(res_pred_raw) >= APPLY_RESIDUAL_MIN_ABS
    res_pred = np.where(active, gain * alpha * res_pred_raw, 0.0).astype(np.float32)
    soc_final = np.clip(du + res_pred, 0.01, 0.99).astype(np.float32)
    return soc_final, res_pred, alpha, active


def calibrate_residual_gain(net, calib_cases, feat_names, mu, sig, window, device,
                            gain_grid=RESIDUAL_GAIN_GRID):
    """
    Select a conservative scalar gain for the residual branch using only training-side
    calibration scenarios. This prevents the residual network from degrading DO-EKF
    when the predicted correction is uncertain.
    """
    rows = []
    best_gain, best_rmse = 0.0, np.inf

    for g in gain_grid:
        rmses = []
        improved_count = 0
        for D in calib_cases:
            du = D["SOC_DU"]
            res_raw = predict_residual_sequence(net, D, feat_names, mu, sig, window, device)
            soc_corr, _, _, _ = apply_residual_correction(du, res_raw, gain=float(g))
            rmse_corr = compute_metrics(soc_corr, D["SOC_true"])["RMSE"]
            rmse_du = compute_metrics(du, D["SOC_true"])["RMSE"]
            rmses.append(rmse_corr)
            if rmse_corr < rmse_du:
                improved_count += 1
        mean_rmse = float(np.mean(rmses))
        rows.append({
            "gain": float(g),
            "calibration_RMSE_mean": mean_rmse,
            "calibration_RMSE_std": float(np.std(rmses, ddof=1)) if len(rmses) > 1 else 0.0,
            "improved_cases": improved_count,
            "n_cases": len(calib_cases),
        })
        if mean_rmse < best_rmse:
            best_rmse = mean_rmse
            best_gain = float(g)

    gain_df = pd.DataFrame(rows)
    gain_df.to_csv(os.path.join(OUT_DIR, "residual_gain_calibration.csv"), index=False)
    print(f"Selected residual correction gain = {best_gain:.2f} | calibration RMSE={best_rmse*100:.4f}%")
    return best_gain, gain_df

