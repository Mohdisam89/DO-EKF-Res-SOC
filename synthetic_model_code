@dataclass
class BatteryParams:
    Q_nom_ref: float = 2.0
    T_ref: float = 25.0
    R0_ref: float = 0.018
    R1_ref: float = 0.012
    C1_ref: float = 2500.0
    kR0_age: float = 1.10
    kR1_age: float = 0.80
    kC1_age: float = 0.40
    kQ_age: float = 1.15
    kR0_lowT: float = 0.030
    kR0_highT: float = 0.008
    kR1_lowT: float = 0.025
    kR1_highT: float = 0.006
    kQ_lowT: float = 0.004
    dOCV_dT: float = 0.00035
    SOC_grid: np.ndarray = field(default_factory=lambda: np.array(
        [0.00,0.03,0.05,0.10,0.20,0.30,0.40,0.50,0.60,0.70,0.80,0.90,1.00], dtype=np.float32))
    OCV_grid: np.ndarray = field(default_factory=lambda: np.array(
        [3.00,3.15,3.25,3.40,3.55,3.65,3.72,3.78,3.84,3.92,4.02,4.12,4.20], dtype=np.float32))

    def ocv(self, soc):
        return np.interp(np.clip(soc, 0.0, 1.0), self.SOC_grid, self.OCV_grid)

    def ocv_with_T(self, soc, T):
        return self.ocv(soc) + self.dOCV_dT * (T - self.T_ref)

    def docv_dsoc(self, soc):
        d = 1e-5
        sp = min(0.999, float(soc) + d)
        sm = max(0.001, float(soc) - d)
        return float((self.ocv(sp) - self.ocv(sm)) / (sp - sm))


def make_estimator_battery_params(true_params):
    """
    Create the biased ECM used by EKF/DO-EKF in the synthetic experiment.

    The generator uses true_params, whereas the estimator uses this biased model.
    This controlled mismatch is intentional: it creates structured residual errors
    similar to those observed in real battery datasets such as NASA.
    """
    est = BatteryParams()
    if not SYNTHETIC_MODEL_MISMATCH:
        return est

    est.R0_ref = true_params.R0_ref * 0.88
    est.R1_ref = true_params.R1_ref * 1.18
    est.C1_ref = true_params.C1_ref * 0.82
    est.dOCV_dT = true_params.dOCV_dT * 0.65

    # Mild smooth OCV bias: small enough to remain realistic, large enough to
    # produce learnable residual structure.
    soc = true_params.SOC_grid.astype(np.float64)
    ocv_bias = 0.008 * np.sin(np.pi * soc) - 0.006 * (soc - 0.5)
    est.SOC_grid = true_params.SOC_grid.copy()
    est.OCV_grid = (true_params.OCV_grid.astype(np.float64) + ocv_bias).astype(np.float32)
    return est


@dataclass
class ThermalParams:
    Tamb_base: float = 25.0
    Rth: float = 7.0
    Cth: float = 420.0
    cooling_noise: float = 0.002


def ecm_params_np(bat, T, SOH):
    dT_lo = max(0.0, bat.T_ref - T)
    dT_hi = max(0.0, T - bat.T_ref)
    R0m = (1 + bat.kR0_lowT*dT_lo - bat.kR0_highT*dT_hi) * (1 + bat.kR0_age*(1-SOH))
    R1m = (1 + bat.kR1_lowT*dT_lo - bat.kR1_highT*dT_hi) * (1 + bat.kR1_age*(1-SOH))
    C1m = max(0.55, 1 - bat.kC1_age*(1-SOH) - 0.003*dT_lo)
    Qm  = max(0.60, SOH**bat.kQ_age * (1 - bat.kQ_lowT*dT_lo))
    return {
        "R0": float(np.clip(bat.R0_ref*R0m, 0.002, 0.090)),
        "R1": float(np.clip(bat.R1_ref*R1m, 0.002, 0.090)),
        "C1": float(np.clip(bat.C1_ref*C1m, 500.0, 8000.0)),
        "Q_eff": float(np.clip(bat.Q_nom_ref*Qm, 0.5, bat.Q_nom_ref)),
    }


