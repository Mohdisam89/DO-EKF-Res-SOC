def train_doekf_qr_multicase(train_cases, val_cases, bat, dt, soc0, vrc0,
                             n_epochs=40, lr=0.035, patience=12, max_train_cases=12):
    """
    Train DO-EKF Q/R with longer optimization and live plots.

    Main change for the underfitting issue:
      - FAST_MODE now uses more epochs.
      - Early stopping is based on validation RMSE.
      - Training and validation curves are saved during training.
    """
    theta = np.array([-11.5, -16.1, -7.6], dtype=np.float64)
    m_adam = np.zeros(3)
    v_adam = np.zeros(3)
    beta1, beta2, eps = 0.9, 0.999, 1e-8
    delta = 1e-4

    train_subset = train_cases[:min(max_train_cases, len(train_cases))]
    val_subset = val_cases if len(val_cases) > 0 else train_subset[-max(1, len(train_subset)//4):]

    best_val = np.inf
    best_theta = theta.copy()
    best_epoch = 0
    bad = 0
    hist = []

    def mean_case_loss(cases, th):
        return float(np.mean([
            np.mean((doekf_forward_np(
                D["I_meas"], D["V_meas"], D["T"], D["SOH_vec"],
                bat, dt, *th, soc0, vrc0
            ) - D["SOC_true"]) ** 2)
            for D in cases
        ]))

    for ep in range(1, n_epochs + 1):
        loss = mean_case_loss(train_subset, theta)

        grad = np.zeros(3)
        for p in range(3):
            thp = theta.copy()
            thp[p] += delta
            grad[p] = (mean_case_loss(train_subset, thp) - loss) / delta

        m_adam = beta1 * m_adam + (1 - beta1) * grad
        v_adam = beta2 * v_adam + (1 - beta2) * (grad ** 2)
        theta = theta - lr * (m_adam / (1 - beta1 ** ep)) / (np.sqrt(v_adam / (1 - beta2 ** ep)) + eps)

        # Evaluate after the update so train/validation curves are comparable.
        train_loss_eval = mean_case_loss(train_subset, theta)
        val_loss = mean_case_loss(val_subset, theta)
        train_rmse = math.sqrt(train_loss_eval) * 100
        val_rmse = math.sqrt(val_loss) * 100

        improved = val_rmse < (best_val - 1e-6)
        if improved:
            best_val = val_rmse
            best_theta = theta.copy()
            best_epoch = ep
            bad = 0
        else:
            bad += 1

        hist.append({
            "epoch": ep,
            "train_rmse": train_rmse,
            "val_rmse": val_rmse,
            "best_val_rmse": best_val,
            "q_soc": float(np.exp(theta[0])),
            "q_vrc": float(np.exp(theta[1])),
            "r": float(np.exp(theta[2])),
            "best_epoch": best_epoch,
        })

        if ep == 1 or ep % 5 == 0 or improved:
            print(
                f"DO-EKF Epoch {ep:03d}/{n_epochs} | "
                f"Train RMSE={train_rmse:.4f}% | Val RMSE={val_rmse:.4f}% | "
                f"Best={best_val:.4f}% @ {best_epoch}"
            )

        if ep % LIVE_PLOT_EVERY == 0:
            plot_doekf_training_progress(hist)
            pd.DataFrame(hist).to_csv(os.path.join(OUT_DIR, "doekf_training_history_live.csv"), index=False)

        if bad >= patience:
            print(f"DO-EKF early stopping at epoch {ep} | best epoch={best_epoch} | best Val RMSE={best_val:.4f}%")
            break

    hist_df = pd.DataFrame(hist)
    hist_df.to_csv(os.path.join(OUT_DIR, "doekf_training_history.csv"), index=False)
    plot_doekf_training_progress(hist)

    if len(hist_df) >= 3 and best_epoch == int(hist_df["epoch"].iloc[-1]):
        print("NOTE: DO-EKF validation RMSE was still improving at the last epoch. "
              "Consider increasing DU_EPOCHS if more convergence is required.")

    return best_theta, hist_df


