def holm_bonferroni(pvalues, alpha=0.05):
    pvalues = np.asarray(pvalues, dtype=float)
    m = len(pvalues)
    order = np.argsort(pvalues)
    adjusted_sorted = np.empty(m, dtype=float)
    running_max = 0.0
    for rank_pos, idx in enumerate(order):
        adj = (m - rank_pos) * pvalues[idx]
        running_max = max(running_max, adj)
        adjusted_sorted[rank_pos] = min(running_max, 1.0)
    adjusted = np.empty(m, dtype=float)
    adjusted[order] = adjusted_sorted
    reject = adjusted <= alpha
    return reject, adjusted


def rank_biserial_from_diff(diff):
    diff = np.asarray(diff, dtype=float)
    diff = diff[diff != 0]
    if len(diff) == 0 or rankdata is None:
        return np.nan
    ranks = rankdata(np.abs(diff))
    w_pos = ranks[diff > 0].sum()
    w_neg = ranks[diff < 0].sum()
    denom = w_pos + w_neg
    return float((w_pos - w_neg) / denom) if denom > 0 else np.nan


def run_statistical_analysis(metrics_long, out_dir=OUT_DIR):
    if friedmanchisquare is None or wilcoxon is None or rankdata is None:
        print("SciPy is required for statistical analysis. Skipping statistical tests.")
        return None, None, None

    wide = metrics_long.pivot(index="scenario_local_index", columns="Method", values="RMSE")
    wide = wide[["EKF", "DO-EKF", "DO-EKF_Res"]].dropna()
    models = list(wide.columns)
    n = len(wide)
    k = len(models)

    stat, pval = friedmanchisquare(wide["EKF"], wide["DO-EKF"], wide["DO-EKF_Res"])
    ranks = np.array([rankdata(row, method="average") for row in wide.values])  # lower RMSE = lower rank
    avg_ranks = ranks.mean(axis=0)
    rank_sums = ranks.sum(axis=0)

    friedman_df = pd.DataFrame({
        "Test": ["Friedman"],
        "Chi_square": [stat],
        "p_value": [pval],
        "n_units": [n],
        "k_models": [k],
    })
    ranks_df = pd.DataFrame({"Method": models, "Average_Rank": avg_ranks, "Rank_Sum": rank_sums})
    ranks_df = ranks_df.sort_values("Average_Rank")

    pairs = [("EKF", "DO-EKF"), ("EKF", "DO-EKF_Res"), ("DO-EKF", "DO-EKF_Res")]
    raw_p = []
    rows = []
    for a, b in pairs:
        # paired difference: positive means b has lower RMSE than a
        diff = wide[a].values - wide[b].values
        try:
            w_stat, p_raw = wilcoxon(wide[a], wide[b], zero_method="wilcox", alternative="two-sided")
        except ValueError:
            w_stat, p_raw = np.nan, 1.0
        raw_p.append(p_raw)
        rows.append({
            "Comparison": f"{a} vs {b}",
            "Mean_RMSE_A_%": float(wide[a].mean() * 100),
            "Mean_RMSE_B_%": float(wide[b].mean() * 100),
            "Mean_Difference_A_minus_B_%": float(diff.mean() * 100),
            "Wilcoxon_W": float(w_stat) if np.isfinite(w_stat) else np.nan,
            "Raw_p": float(p_raw),
            "Rank_Biserial_r": rank_biserial_from_diff(diff),
        })

    reject, p_adj = holm_bonferroni(raw_p, alpha=0.05)
    for i in range(len(rows)):
        rows[i]["Holm_Adjusted_p"] = float(p_adj[i])
        rows[i]["Significant_0.05"] = bool(reject[i])

    pairwise_df = pd.DataFrame(rows)

    friedman_df.to_csv(os.path.join(out_dir, "stat_friedman_results.csv"), index=False)
    ranks_df.to_csv(os.path.join(out_dir, "stat_average_ranks.csv"), index=False)
    pairwise_df.to_csv(os.path.join(out_dir, "stat_pairwise_wilcoxon_holm.csv"), index=False)

    print("\n" + "═" * 86)
    print("Statistical Analysis on Synthetic Validation RMSE")
    print("═" * 86)
    print(f"Friedman chi-square = {stat:.4f} | p = {pval:.6f}")
    print("\nAverage ranks: lower is better")
    print(ranks_df.to_string(index=False, float_format="%.4f"))
    print("\nPairwise Wilcoxon-Holm results")
    print(pairwise_df.to_string(index=False, float_format="%.6f"))

    return friedman_df, ranks_df, pairwise_df

