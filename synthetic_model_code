    idx = np.arange(N_MC); rng.shuffle(idx)
    n_train = int(round(TRAIN_RATIO*N_MC))
    train_cases = [cases[i] for i in idx[:n_train]]
    val_cases = [cases[i] for i in idx[n_train:]]
    print(f"\nTrain scenarios: {len(train_cases)}")
    print(f"Validation scenarios: {len(val_cases)}")

    print("\nTraining DO-EKF Q/R...")
    n_du_val = max(1, int(round(0.2*len(train_cases))))
    du_train_cases = train_cases[:-n_du_val]
    du_val_cases = train_cases[-n_du_val:]
    soc0_est, vrc0_est = 0.75, 0.0
    theta, doekf_hist = train_doekf_qr_multicase(
        du_train_cases, du_val_cases, bat, DT, soc0_est, vrc0_est,
        n_epochs=DU_EPOCHS, lr=0.035, patience=DU_PATIENCE,
        max_train_cases=QR_TRAIN_CASES
    )
    Q_du = np.diag([np.exp(theta[0]), np.exp(theta[1])]).astype(np.float64)
    R_du = float(np.exp(theta[2]))
    print(f"Learned Q = diag([{Q_du[0,0]:.3e}, {Q_du[1,1]:.3e}])")
    print(f"Learned R = {R_du:.3e}")

    def add_du(D):
        DD = dict(D)
        soc_du, v_pred, innov = run_ekf_np(D["I_meas"], D["V_meas"], D["T"], D["SOH_vec"],
                                  bat, DT, Q_du, R_du, soc0_est, vrc0_est)
        DD["SOC_DU"] = soc_du
        DD["V_EKF_pred"] = v_pred
        DD["V_EKF_error"] = innov
        return DD

    train_cases = [add_du(D) for D in train_cases]
    val_cases = [add_du(D) for D in val_cases]

    print("\nPreparing residual LSTM datasets...")
    # Use a training-side split for residual validation and gain calibration.
    # The final validation scenarios remain untouched until final model comparison.
    n_res_cal = max(1, int(round(RESIDUAL_CALIBRATION_RATIO * len(train_cases))))
    res_train_cases = train_cases[:-n_res_cal]
    res_calib_cases = train_cases[-n_res_cal:]
    print(f"Residual train scenarios: {len(res_train_cases)}")
    print(f"Residual calibration scenarios: {len(res_calib_cases)}")

    Xtr, Ytr, Wtr, mu, sig = stack_residual_windowed_features(
        res_train_cases, RES_FEAT, WINDOW, return_weights=True, hard_mining=True,
        min_abs=HARD_RESIDUAL_MIN_ABS
    )
    Xrv, Yrv, Wrv, _, _ = stack_residual_windowed_features(
        res_calib_cases, RES_FEAT, WINDOW, mu, sig, return_weights=True, hard_mining=True,
        min_abs=HARD_RESIDUAL_MIN_ABS
    )
    print(f"X_train residual: {Xtr.shape} | Y_train residual: {Ytr.shape}")
    print(f"X_resval residual: {Xrv.shape} | Y_resval residual: {Yrv.shape}")

    global PRED_CLIP
    if DYNAMIC_PRED_CLIP:
        raw_train_res = np.concatenate([
            np.clip(D["SOC_true"] - D["SOC_DU"], -RESIDUAL_CLIP, RESIDUAL_CLIP)
            for D in res_train_cases
        ])
        # Conservative residual bound: the residual branch corrects meaningful errors only.
        PRED_CLIP = float(np.clip(1.5 * np.std(raw_train_res), 0.006, 0.010))
    print(f"Dynamic residual prediction clip PRED_CLIP = {PRED_CLIP:.5f} ({PRED_CLIP*100:.2f}%)")

    print("\nTraining Residual BiLSTM with hard-residual mining...")
    residual_model = ResidualBiLSTMNet(n_feat=len(RES_FEAT), hidden=HIDDEN, n_layers=2)
    residual_model, hist = train_residual_net(
        residual_model, Xtr, Ytr, Xrv, Yrv,
        epochs=RES_EPOCHS, lr=2e-4, device=device,
        batch_size=BATCH_SIZE, patience=RES_PATIENCE,
        Wtr=Wtr, Wvl=Wrv
    )
    hist.to_csv(os.path.join(OUT_DIR, "residual_training_history.csv"), index=False)
    plot_training_history(hist)

    print("\nCalibrating residual correction gain on training-side calibration scenarios...")
    residual_gain, gain_df = calibrate_residual_gain(
        residual_model, res_calib_cases, RES_FEAT, mu, sig, WINDOW, device
    )

    print("\nEvaluating validation scenarios using only the three paper models...")
    rows = []
    metric_rows = []
    first_example = None

    for local_i, D in enumerate(val_cases):
        ekf, _, _ = run_ekf_np(
            D["I_meas"], D["V_meas"], D["T"], D["SOH_vec"],
            bat, DT, Q_EKF_BASE, R_EKF_BASE, soc0_est, vrc0_est
        )

        du = D["SOC_DU"]

        # NASA-matched equation:
        #   residual = network(features)
        #   DO-EKF_Res = SOC_DU + residual
        # Apply confidence-guided, thresholded, and calibrated residual correction.
        res_pred_raw = predict_residual_sequence(
            residual_model, D, RES_FEAT, mu, sig, WINDOW, device
        )
        DO-EKF_res, res_pred, alpha, active_mask = apply_residual_correction(
            du, res_pred_raw, gain=residual_gain
        )

        m_ekf = compute_metrics(ekf, D["SOC_true"])
        m_du = compute_metrics(du, D["SOC_true"])
        m_res = compute_metrics(DO-EKF_res, D["SOC_true"])

        rows.append({
            "scenario_local_index": local_i,
            "EKF_RMSE": m_ekf["RMSE"],
            "EKF_MAE": m_ekf["MAE"],
            "DU_RMSE": m_du["RMSE"],
            "DU_MAE": m_du["MAE"],
            "DO-EKF_Res_RMSE": m_res["RMSE"],
            "DO-EKF_Res_MAE": m_res["MAE"],
            "Mean_abs_residual_pred": float(np.mean(np.abs(res_pred))),
            "Max_abs_residual_pred": float(np.max(np.abs(res_pred))),
            "Mean_alpha": float(np.mean(alpha)),
            "Residual_gain": float(residual_gain),
            "Active_correction_fraction": float(np.mean(active_mask)),
        })

        for method, mm in [
            ("EKF", m_ekf),
            ("DO-EKF", m_du),
            ("DO-EKF_Res", m_res),
        ]:
            metric_rows.append({
                "scenario_local_index": local_i,
                "Method": method,
                "RMSE": mm["RMSE"],
                "MAE": mm["MAE"],
            })

        print(
            f"Val {local_i+1:02d}/{len(val_cases)} | "
            f"EKF={m_ekf['RMSE']*100:.4f}% | "
            f"DO-EKF={m_du['RMSE']*100:.4f}% | "
            f"DO-EKF_Res={m_res['RMSE']*100:.4f}% | "
            f"Mean|res|={np.mean(np.abs(res_pred))*100:.4f}%"
        )

        if first_example is None:
            first_example = (D, ekf, du, res_pred, DO-EKF_res)

    results = pd.DataFrame(rows)
    metrics_long = pd.DataFrame(metric_rows)

    summary_long = (
        metrics_long.groupby("Method")
        .agg(
            RMSE_mean=("RMSE","mean"),
            RMSE_std=("RMSE","std"),
            MAE_mean=("MAE","mean"),
        )
        .reset_index()
    )

    order = {"EKF": 0, "DO-EKF": 1, "DO-EKF_Res": 2}
    summary_long["order"] = summary_long["Method"].map(order)
    summary_long = summary_long.sort_values("order").drop(columns="order")

    results.to_csv(os.path.join(OUT_DIR, "synthetic_3models_validation_results_wide.csv"), index=False)
    metrics_long.to_csv(os.path.join(OUT_DIR, "synthetic_3models_validation_metrics_long.csv"), index=False)
    summary_long.to_csv(os.path.join(OUT_DIR, "synthetic_3models_summary.csv"), index=False)

    print_three_model_table(summary_long)

    try:
        ekf_rmse = float(summary_long.loc[summary_long["Method"] == "EKF", "RMSE_mean"].iloc[0])
        du_rmse = float(summary_long.loc[summary_long["Method"] == "DO-EKF", "RMSE_mean"].iloc[0])
        res_rmse = float(summary_long.loc[summary_long["Method"] == "DO-EKF_Res", "RMSE_mean"].iloc[0])

        print(f"\nImprovement of DO-EKF_Res over EKF   : {(ekf_rmse-res_rmse)/ekf_rmse*100:.2f}%")
        print(f"Improvement of DO-EKF_Res over DO-EKF: {(du_rmse-res_rmse)/du_rmse*100:.2f}%")
    except Exception:
        pass

    if first_example is not None:
        plot_soc_example(*first_example)

    plot_three_model_bar(summary_long)
    run_statistical_analysis(metrics_long, OUT_DIR)

    print(f"\nSaved results in: {OUT_DIR}")
    print("Synthetic three-model experiment completed.")
    return residual_model, summary_long, metrics_long, hist, doekf_hist


