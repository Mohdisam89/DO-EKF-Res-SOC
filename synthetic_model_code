# 2. Synthetic data
# ============================================================
def generate_mc_data(N, dt, bat, th, seed, SOC0_nom=0.92, Vrc0=0.0,
                     sig_soc_base=4e-5, sig_v_base=8e-3,
                     sig_ibias=0.015, sig_vbias=0.006):
    rng = np.random.default_rng(seed)
    SOH0 = 0.82 + 0.17*rng.random()
    dSOH = 0.001 + 0.004*rng.random()
    SOH_v = np.linspace(SOH0, max(0.70, SOH0-dSOH), N).astype(np.float32)
    SOC0 = float(np.clip(SOC0_nom + 0.04*rng.standard_normal(), 0.75, 0.98))
    tidx = np.arange(N, dtype=np.float32)

    I_base = (0.55 + 0.75*np.sin(2*np.pi*tidx/(500+200*rng.random()))
              + 0.35*np.sin(2*np.pi*tidx/(70+60*rng.random()))
              + 0.35*rng.standard_normal(N))
    pulse = np.zeros(N, dtype=np.float32)
    for _ in range(rng.integers(14, 29)):
        st = rng.integers(0, N-120)
        pw = rng.integers(30, 181)
        amp = -1.2 + 4.0*rng.random()
        pulse[st:min(N, st+pw)] += amp
    I_true = np.clip(I_base + 0.35*pulse, -2.0, 4.0).astype(np.float32)
    I_bias = sig_ibias*rng.standard_normal()
    V_bias = sig_vbias*rng.standard_normal()
    I_meas = (I_true + I_bias + 0.015*rng.standard_normal(N)).astype(np.float32)

    amb_sh = -10 + 25*rng.random()
    Tamb = (th.Tamb_base + amb_sh + 2.5*np.sin(2*np.pi*tidx/(N*(0.7+0.6*rng.random()))
            + 2*np.pi*rng.random())).astype(np.float32)

    SOC = np.zeros(N, dtype=np.float32)
    Vrc = np.zeros(N, dtype=np.float32)
    T = np.zeros(N, dtype=np.float32)
    V_true = np.zeros(N, dtype=np.float32)
    V_meas = np.zeros(N, dtype=np.float32)
    SOC[0] = SOC0
    Vrc[0] = Vrc0
    T[0] = float(Tamb[0]) + rng.standard_normal()

    for k in range(N-1):
        prm = ecm_params_np(bat, float(T[k]), float(SOH_v[k]))
        alpha = np.exp(-dt/(prm["R1"]*prm["C1"]))
        sig_s = sig_soc_base*(1 + 2.0*(1-SOH_v[k]) + 0.04*max(0.0, 25-T[k]))
        SOC[k+1] = np.clip(SOC[k] - dt/(prm["Q_eff"]*3600.0)*I_true[k]
                            + sig_s*rng.standard_normal(), 0.01, 0.99)
        Vrc[k+1] = alpha*Vrc[k] + (1-alpha)*prm["R1"]*I_true[k]
        heat = I_true[k]**2 * prm["R0"]
        dT_step = (dt/th.Cth)*(heat - (T[k]-Tamb[k])/th.Rth)
        T[k+1] = np.clip(T[k] + dT_step + th.cooling_noise*rng.standard_normal(), -5.0, 60.0)

    for k in range(N):
        prm = ecm_params_np(bat, float(T[k]), float(SOH_v[k]))
        ocv_T = bat.ocv(SOC[k]) + bat.dOCV_dT*(T[k]-bat.T_ref)

        hidden_mismatch = 0.0
        if SYNTHETIC_MODEL_MISMATCH:
            aging_factor = 1.0 + 1.5 * (1.0 - float(SOH_v[k]))
            hidden_mismatch = (
                HYSTERESIS_GAIN * np.tanh(1.8 * float(I_true[k])) * aging_factor
                + OCV_WARP_GAIN * np.sin(2.0 * np.pi * float(SOC[k])) * (1.0 - float(SOH_v[k]))
                + THERMAL_DRIFT_GAIN * (float(T[k]) - bat.T_ref)
            )

        V_true[k] = ocv_T - prm["R0"]*I_true[k] - Vrc[k] + hidden_mismatch
        sig_v = sig_v_base*(1 + 0.015*abs(T[k]-25) + 1.8*(1-SOH_v[k]))
        V_meas[k] = V_true[k] + V_bias + sig_v*rng.standard_normal()

    return {"SOC_true": SOC.astype(np.float32), "V_meas": V_meas.astype(np.float32),
            "I_meas": I_meas.astype(np.float32), "T": T.astype(np.float32),
            "Tamb": Tamb.astype(np.float32), "SOH_vec": SOH_v.astype(np.float32),
            "V_true": V_true.astype(np.float32), "I_true": I_true.astype(np.float32)}


def add_derived_features(D, dt=1.0):
    """
    Create the same feature family used in the NASA training code:
      Voltage_measured, Current_discharge, Temperature_measured, SOH,
      SOH_delta, time_norm, dV_dt, dI_dt, discharged_Ah, cumulative_Wh,
      R_dyn_approx.

    This keeps the simulation experiment mathematically consistent with
    the NASA experiment. SOC and SOH are not redefined after this point.
    """
    I = D["I_meas"].astype(np.float64)
    V = D["V_meas"].astype(np.float64)
    T = D["T"].astype(np.float64)
    SOH = D["SOH_vec"].astype(np.float64)
    Nloc = len(I)

    t = np.arange(Nloc, dtype=np.float64) * dt
    time_norm = t / max(t[-1], 1e-12)

    dV_dt = np.gradient(V, dt)
    dI_dt = np.gradient(I, dt)

    # NASA-prepared data uses positive discharge current.
    # Synthetic current includes charge/discharge pulses, therefore cumulative Ah/Wh
    # are generated from measured current directly for consistency with the filter dynamics.
    discharged_Ah = np.cumsum(I * dt) / 3600.0
    cumulative_Wh = np.cumsum(V * I * dt) / 3600.0

    dV = np.gradient(V)
    dI = np.gradient(I)
    R_dyn = np.full_like(V, np.nan, dtype=np.float64)
    valid = np.abs(dI) > 1e-4
    R_dyn[valid] = -dV[valid] / dI[valid]
    R_dyn = np.clip(R_dyn, -5.0, 5.0)
    if np.any(np.isfinite(R_dyn)):
        med = np.nanmedian(R_dyn)
        R_dyn = np.where(np.isfinite(R_dyn), R_dyn, med)
    else:
        R_dyn = np.zeros_like(V)

    out = dict(D)
    out["Voltage_measured"] = V.astype(np.float32)
    out["Current_discharge"] = I.astype(np.float32)
    out["Temperature_measured"] = T.astype(np.float32)
    out["SOH"] = SOH.astype(np.float32)
    out["SOH_delta"] = (1.0 - SOH).astype(np.float32)
    out["time_norm"] = time_norm.astype(np.float32)
    out["dV_dt"] = dV_dt.astype(np.float32)
    out["dI_dt"] = dI_dt.astype(np.float32)
    out["discharged_Ah"] = discharged_Ah.astype(np.float32)
    out["cumulative_Wh"] = cumulative_Wh.astype(np.float32)
    out["R_dyn_approx"] = R_dyn.astype(np.float32)

    # Backward-compatible aliases for any remaining plotting/legacy lines.
    out["dV"] = out["dV_dt"]
    out["dI"] = out["dI_dt"]
    cc = discharged_Ah
    out["cc"] = ((cc - cc.mean()) / (cc.std() + 1e-12)).astype(np.float32)
    return out


# ============================================================
# 3. EKF / DO-EKF
# ============================================================
def run_ekf_np(I, Vmeas, T_arr, SOH_arr, bat, dt, Q, R, soc0, vrc0):
    """
    EKF equation aligned with the NASA code:
      returns SOC estimate, EKF voltage prediction, and innovation.
    """
    n = len(I)
    x = np.array([soc0, vrc0], dtype=np.float64)
    P = np.diag([0.03, 0.003]).astype(np.float64)

    soc_out = np.zeros(n, dtype=np.float64)
    v_pred_out = np.zeros(n, dtype=np.float64)
    innov_out = np.zeros(n, dtype=np.float64)

    for k in range(n):
        prm = ecm_params_np(bat, float(T_arr[k]), float(SOH_arr[k]))
        dtk = float(dt)
        if not np.isfinite(dtk) or dtk <= 0:
            dtk = 1.0

        alpha = np.exp(-dtk/(prm["R1"]*prm["C1"]))
        F = np.array([[1.0, 0.0], [0.0, alpha]], dtype=np.float64)

        xp = np.array([
            np.clip(x[0] - dtk/(prm["Q_eff"]*3600.0)*float(I[k]), 0.01, 0.99),
            alpha*x[1] + (1.0-alpha)*prm["R1"]*float(I[k])
        ], dtype=np.float64)

        Pp = F @ P @ F.T + Q

        Vp = bat.ocv_with_T(xp[0], float(T_arr[k])) - prm["R0"]*float(I[k]) - xp[1]
        H = np.array([[bat.docv_dsoc(xp[0]), -1.0]], dtype=np.float64)

        S = float(H @ Pp @ H.T) + R + 1e-12
        K = (Pp @ H.T) / S

        innovation = float(Vmeas[k]) - Vp
        x = xp + K.flatten()*innovation
        x[0] = np.clip(x[0], 0.01, 0.99)

        A = np.eye(2) - K @ H
        P = A @ Pp @ A.T + K*R@K.T
        P = 0.5*(P + P.T) + 1e-12*np.eye(2)

        soc_out[k] = x[0]
        v_pred_out[k] = Vp
        innov_out[k] = innovation

    return soc_out.astype(np.float32), v_pred_out.astype(np.float32), innov_out.astype(np.float32)


def doekf_forward_np(I, Vmeas, T_arr, SOH_arr, bat, dt, lq_soc, lq_vrc, lr_, soc0, vrc0):
    Q = np.diag([np.exp(lq_soc), np.exp(lq_vrc)]).astype(np.float64)
    R = float(np.exp(lr_))
    return run_ekf_np(I, Vmeas, T_arr, SOH_arr, bat, dt, Q, R, soc0, vrc0)[0]



def plot_doekf_training_progress(hist, out_dir=OUT_DIR, filename="training_progress_doekf_live"):
    if not hist:
        return
    H = pd.DataFrame(hist)
    best_idx = int(H["val_rmse"].idxmin())
    best_ep = int(H.loc[best_idx, "epoch"])
    best_val = float(H.loc[best_idx, "val_rmse"])

    fig, ax = plt.subplots(figsize=(6.8, 3.8))
    ax.plot(H["epoch"], H["train_rmse"], marker="o", linewidth=1.8, label="Training RMSE")
    ax.plot(H["epoch"], H["val_rmse"], marker="s", linewidth=1.8, label="Validation RMSE")
    ax.axvline(best_ep, linestyle="--", linewidth=1.2, color="0.35", label=f"Best epoch = {best_ep}")
    ax.scatter([best_ep], [best_val], s=55, color="black", zorder=5)
    ax.set_xlabel("Epoch")
    ax.set_ylabel("RMSE (%)")
    ax.set_title("DO-EKF Covariance Optimization")
    ax.grid(True, linestyle="--", linewidth=0.6, alpha=0.55)
    ax.legend(frameon=True, fontsize=8)
    fig.tight_layout()
    fig.savefig(os.path.join(out_dir, f"{filename}.png"), dpi=300, bbox_inches="tight")
    fig.savefig(os.path.join(out_dir, f"{filename}.pdf"), bbox_inches="tight")
    plt.close(fig)


